# Copy to .env (gitignored) and fill in. The agent refuses to start without
# PROJECTS_FILE and DEPLOY_WEBHOOK_SECRET.

# Absolute path to the project list. Because DOCKER_ROOT is mounted at the same
# path inside the container, this is also the host path.
PROJECTS_FILE=/volume1/docker/deploy/projects.json

# Shared HMAC secret, 32+ characters. Put the same value in each app repo as
# the DEPLOY_WEBHOOK_SECRET Actions secret. Generate with:
#   openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=

# Optional. Host path mounted at the same path inside the container, so the
# PROJECTS_FILE path and the "dir" values in projects.json resolve identically.
DOCKER_ROOT=/volume1/docker

# Optional. Existing external Docker network shared with the tunnel or reverse
# proxy that reaches this container.
DEPLOY_NETWORK=nas-shared
